# Deployer wallet — needs Base Sepolia ETH for gas. Get testnet ETH from
# https://www.base.org/faucets or a Coinbase Wallet faucet.
DEPLOYER_PRIVATE_KEY=

BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<your-key>
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Optional — only needed if you want `forge script --verify` to auto-verify
# contracts on Basescan after deploy.
BASESCAN_API_KEY=
