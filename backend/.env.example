PORT=4022

# --- x402 / CDP ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_PAY_TO_ADDRESS=
CDP_X402_SERVER_ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_nft_marketplace

# --- Base L2 chain ---
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
# Fill these in after running contracts/script/Deploy.s.sol
AGENT_REGISTRY_ADDRESS=
NFT_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=
COMMUNITY_REGISTRY_ADDRESS=
OFFERS_CONTRACT_ADDRESS=
# The backend's relayer wallet - needs gas ETH. It must own ONLY AgentRegistry
# (see contracts/script/Deploy.s.sol: RELAYER_ADDRESS). NEVER put the key that
# owns AgentNFT / Marketplace / Offers (OWNER_ADDRESS, ideally a multisig)
# here: those contracts hold user escrow and fee settings.
RELAYER_PRIVATE_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# Only matters for browser-based requests (the frontend) — non-browser
# agent clients aren't subject to CORS at all. Defaults to Next.js's
# standard `npm run dev` port. If you're running the frontend via
# docker-compose instead (which maps to host port 3001, not 3000 — see
# docker-compose.yml), add http://localhost:3001 too.
ALLOWED_ORIGINS=http://localhost:3000
# Optional: regex for per-deploy origins (Vercel previews), e.g.
#   my-project-[a-z0-9]+-my-team\.vercel\.app
# ALLOWED_ORIGIN_PATTERN=

# --- Indexer ---
# Set to the actual deployment block once you know it (Basescan lookup
# after Deploy.s.sol runs) — defaulting to 0 backfills from genesis,
# which works but is slow and pointless.
INDEXER_START_BLOCK=0
INDEXER_POLLING_INTERVAL_MS=4000

# --- IPFS ---
PINATA_JWT=

# --- Pricing (USD, per x402-gated action) — note: minting, listing,
# buying, and creating communities are all agent-signed on-chain
# transactions now, NOT backend routes, so there's no price for them here.
PRICE_PREPARE_METADATA=0.02
PRICE_BROWSE=0.01
PRICE_GET_NFT=0.01
PRICE_LIST_COMMUNITIES=0.01
PRICE_COMMUNITY_METADATA=0.01
PRICE_COMMUNITY_ASSOCIATION=0.01
PRICE_POST=0.005

# --- Security / abuse controls ---
# Reverse-proxy hops in front of the server (Render = 1, local dev = 0).
# Wrong value => every user shares one rate-limit bucket (or IPs are spoofable).
TRUST_PROXY=1
# Charged (x402, USDC) for register_agent - sybil + relayer-gas defense. 0 = free.
PRICE_REGISTER_AGENT=0.05
REGISTRATIONS_PER_IP_PER_HOUR=5
SSE_MAX_CONNECTIONS=200
SSE_MAX_PER_IP=5
# Blocks of confirmation depth before the indexer reads them.
INDEXER_CONFIRMATIONS=2
# Comma-separated IPFS gateways used for metadata fetches.
# IPFS_GATEWAYS=https://gateway.pinata.cloud/ipfs/   # comma-separated; ipfs.io / dweb.link / w3s.link no longer serve scripts or <img> tags. For production use a dedicated gateway (Pinata -> Gateways): https://<name>.mypinata.cloud/ipfs/
# Override only if not using the official USDC for BASE_CHAIN_ID.
# USDC_ADDRESS=
# TLS certificate verification for the database is ON; set true only for a self-signed provider.
# DATABASE_SSL_INSECURE=false
# Required to use the admin-only /api/collections/:id/verify route.
# ADMIN_SECRET=

# --- Collection identity, uploads, platform metadata ---
# Everything an agent does on the platform is paid by the agent (x402 fees go to X402_PAY_TO_ADDRESS):
PRICE_LINK_WALLET=0.02
PRICE_COLLECTION_PROFILE=0.01
# Image upload pins files in YOUR Pinata account, so it is OFF unless you enable it. Agents can always
# supply their own https:// image URL or an ipfs:// URL they pinned themselves. If you turn this on, the
# Pinata API key also needs the pinFileToIPFS permission.
# ENABLE_IMAGE_UPLOAD=true
# PRICE_UPLOAD_IMAGE=0.02
# UPLOADS_MAX_PER_DAY=20
# UPLOADS_MAX_BYTES_PER_DAY=52428800
# Served at GET /api/contract-metadata (the target for AgentNFT.setContractURI):
# PLATFORM_NAME=OpenEden Agent NFTs
# PLATFORM_DESCRIPTION=NFTs minted, collected and traded by autonomous AI agents on Base.
# PLATFORM_IMAGE_URL=https://...
# SITE_URL=https://your-site.vercel.app

