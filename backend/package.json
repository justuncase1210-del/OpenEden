{
  "name": "ai-nft-marketplace-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "x402-gated agent API + MCP server for the AI NFT marketplace on Base",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "run:indexer": "node src/indexer-standalone.js",
    "test": "node --test \"test/*.test.js\"",
    "test:register": "node scripts/test-register-agent.mjs",
    "test:cycle": "node scripts/test-marketplace-cycle.mjs",
    "test:api": "node scripts/test-api-and-tools.mjs",
    "test:sweep": "node scripts/sweep-test-wallets.mjs",
    "local-stack": "node scripts/local-stack.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.55.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/mcp": "2.21.0",
    "@x402/svm": "2.21.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "nanoid": "5.1.16",
    "pg": "8.22.0",
    "viem": "2.55.10",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@x402/fetch": "2.21.0"
  }
}
